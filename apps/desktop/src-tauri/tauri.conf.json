{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pensive Mesh",
  "version": "0.1.0",
  "identifier": "com.koichinishizuka.pensive-mesh",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm frontend:build",
    "frontendDist": "../../../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Pensive Mesh",
        "width": 1440,
        "height": 920,
        "minWidth": 1040,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "Productivity",
    "shortDescription": "Owner-controlled personal context",
    "longDescription": "A local-first encrypted memory and context workbench where sources remain evidence and memories remain revisable claims."
  }
}
